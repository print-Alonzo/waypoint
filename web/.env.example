# Which city dataset to build (data/<slug>/). Defaults to metro-manila.
NEXT_PUBLIC_CITY=metro-manila

# Canonical site origin, used as `metadataBase` so og:image resolves to an
# absolute URL (social previews for the /reddit, /promo, ... channel links).
# Optional: on Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL, and
# locally to http://localhost:3000. Set it once a real domain is attached.
NEXT_PUBLIC_SITE_URL=

# A Mapbox public access token — enables real road routes + road-based
# travel times on the result map. Without it, the app falls back to straight
# lines and haversine-estimated times (see README "Road routing"). Public/
# client-side token by design; restrict it by URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# MongoDB Atlas connection string + database name for the willingness-to-pay
# validation funnel (app/api/validation/route.ts). Server-only — do NOT prefix
# with NEXT_PUBLIC_. Leave unset to disable capture (the route returns 503);
# set the `validation` flag in lib/features.ts to false to hide the funnel's UI
# entirely once the study ends.
#
# After changing the schema (see lib/validation/mongo.ts / app/api/validation/
# route.ts), run the one-time migration against this database:
#   node scripts/validation-migrate.mjs           # report only
#   node scripts/validation-migrate.mjs --apply    # backfill + create indexes
# It reads MONGODB_URI/MONGODB_DB from .env.local automatically when run from
# web/ (not from this file — .env.example is a template, never loaded at
# runtime). See README "Validation funnel" for the moderated-session (?new=1)
# procedure.
MONGODB_URI=
MONGODB_DB=waypoint_validation
